# VisionGuard AI Environment Variables

# Gemini AI API Key (Required for AI Vision / Assistant)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Supabase Authentication & PostgreSQL Database
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional Google Maps API Key for Navigation
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# VisionGuard Backend Service URL
VISIONGUARD_BACKEND_URL=http://10.0.2.2:8000

